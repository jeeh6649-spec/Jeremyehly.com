    },
    {
      "id": "ohmu",
      "order": 2,
      "title": "OHMU",
      "content": "content/projects/02-ohmu.md",
      "summary": "A rock-like table light combines a honeycomb aperture with a warm internal glow, translating geology and biomimicry into a tactile object.",
      "heroAsset": "ohmu-01"
    },
    {
      "id": "frond",
      "order": 3,
      "title": "Frond",
      "content": "content/projects/03-frond.md",
      "summary": "Layered leaf forms create a pendant whose pattern, translucency, and silhouette turn botanical observation into filtered light.",
      "heroAsset": "frond-01"
    },
    {
      "id": "ember",
      "order": 4,
      "title": "Ember",
      "content": "content/projects/04-ember.md",
      "summary": "A faceted timber shade glows like a coal or a new branch emerging from a trunk, bringing warmth and seasonal memory into a compact lamp.",
      "heroAsset": "ember-01"
    },
    {
      "id": "nimbria",
      "order": 5,
      "title": "Nimbria",
      "content": "content/projects/05-nimbria.md",
      "summary": "A floating lotus-inspired lamp brings light to a dormant winter pond through a layered assembly of textile, metal, rubber, and light.",
      "heroAsset": "nimbria-01"
    },
    {
      "id": "yasuragi",
      "order": 6,
      "title": "Yasuragi",
      "content": "content/projects/06-yasuragi.md",
      "summary": "Reclaimed cedar and layered paper form a quiet floor lamp shaped by Japanese principles of simplicity, imperfection, shadow, and pause.",
      "heroAsset": "yasuragi-01"
    },
    {
      "id": "lunara",
      "order": 7,
      "title": "Lunara",
      "content": "content/projects/07-lunara.md",
      "summary": "A layered wall sconce abstracts orchid petals and veins into a soft, stable light intended for a child's room.",
      "heroAsset": "lunara-01"
    },
    {
      "id": "eyrie",
      "order": 8,
      "title": "Eyrie",
      "content": "content/projects/08-eyrie.md",
