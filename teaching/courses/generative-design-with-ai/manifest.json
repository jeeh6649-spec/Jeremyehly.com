{
  "course": {
    "slug": "generative-design-with-ai",
    "title": "Generative Design with AI",
    "historicalTitle": "Lassoing the Robots",
    "courseCode": "ENVD 4365-002",
    "term": "Spring 2026",
    "institution": "University of Colorado Boulder",
    "program": "Environmental Design",
    "brandStylesheet": "../brand/brand-tokens.css",
    "summary": "An advanced environmental design seminar exploring how generative tools can support research, ideation, visualization, fabrication, and speculative storytelling without surrendering human judgment or creative agency.",
    "mediaNote": "Selected course work and instructor demonstrations.",
    "content": {
      "overview": "content/course-overview.md",
      "instructorReflection": "content/instructor-reflection.md",
      "criticalReflections": "content/critical-reflections.md",
      "studentFeedback": "content/student-feedback.md"
    }
  },
  "groups": [
    {
      "id": "control-geometry",
      "order": 1,
      "title": "From Control Geometry to Exploration",
      "description": "Analog models become intentional inputs for prompting, iteration, refinement, alternate views, and motion."
    },
    {
      "id": "image-to-object",
      "order": 2,
      "title": "From Image to Physical Object",
      "description": "Students translate prompts and images into generated 3D geometry and tangible printed objects."
    },
    {
      "id": "speculative-design",
      "order": 3,
      "title": "Speculative Design in 2051",
      "description": "Short films use generative media to take critical positions on AI, design practice, and daily life."
    }
  ],
  "projects": [
    {
      "id": "multistory-building",
      "group": "control-geometry",
      "order": 1,
      "title": "Multistory Building",
      "description": "A Duplo model directs an architectural exploration across image generation, iteration, and animation."
    },
    {
      "id": "yacht",
      "group": "control-geometry",
      "order": 2,
      "title": "Yacht",
      "description": "A constrained block model becomes a test bed for formal, material, and stylistic variation."
    },
    {
      "id": "snow-blaster",
      "group": "control-geometry",
      "order": 3,
      "title": "Snow Blaster",
      "description": "A physical control model guides the development of a speculative snow vehicle."
    },
    {
      "id": "art-to-ring",
      "group": "image-to-object",
      "order": 1,
      "title": "Art to Ring",
      "description": "A visual reference moves through prompting, image generation, digital modeling, and fabrication."
    },
    {
      "id": "portrait-chess-pieces",
      "group": "image-to-object",
      "order": 2,
      "title": "Portrait Chess Pieces",
      "description": "Portrait references become directed images, generated 3D models, and printed chess pieces."
    },
    {
      "id": "bunny-key-ring",
      "group": "image-to-object",
      "order": 3,
      "title": "Bunny Key Ring",
      "description": "A photographed subject becomes an image prompt, digital model, and small printed object."
    },
    {
      "id": "ai-optimized-life",
      "group": "speculative-design",
      "order": 1,
      "title": "AI-Optimized Life",
      "statement": "What if time stopped feeling real because AI optimized every moment of your life?"
    },
    {
      "id": "attention-and-boredom",
      "group": "speculative-design",
      "order": 2,
      "title": "Attention and Boredom",
      "statement": "What if, by 2051, AI-driven overstimulation destroyed humanity's ability to tolerate boredom, triggering a stimulant epidemic that collapsed society?"
    },
    {
      "id": "life-beyond-mandatory-work",
      "group": "speculative-design",
      "order": 3,
      "title": "Life Beyond Mandatory Work",
      "statement": "What if by 2051, work is no longer mandatory and people are free to choose how they spend their time, shaping their lives around play, creativity, and personal fulfillment?"
    },
    {
      "id": "architecture-after-ai-failure",
      "group": "speculative-design",
      "order": 4,
      "title": "Architecture After AI Failure",
      "statement": "What if by 2051 architecture became so dependent on AI that when the systems failed, the profession had to rediscover drawing, building, and human knowledge from the ground up?"
    },
    {
      "id": "vapor-cloud-infrastructure",
      "group": "speculative-design",
      "order": 5,
      "title": "Vapor Cloud Infrastructure",
      "statement": "What if in 2051 AI-powered atmospheric hydration clouds replaced plumbing, transforming water from an invisible public utility into a visible guided service that reshaped domestic ritual, urban life, and access to survival itself?"
    }
  ],
